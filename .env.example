# LIFELINK Environment Variables
# Copy to .env.local for local dev, or add in Vercel dashboard for production

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ontomorph Digital Twin Platform (DTP)
ONTOMORPH_API_KEY=dtp_live_personal_your_key_here
ONTOMORPH_BASE_URL=https://api.ontomorph.com

# Ontomorph HOLON Knowledge API (clinical summaries)
HOLON_API_KEY=holon_your_key_here

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0

# JWT Secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Encryption Key (16 bytes hex)
ENCRYPTION_KEY=
