# LIFELINK Environment Variables
# Copy this file to .env.local and fill in the values

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ontomorph API (single key — also used as fallback for HOLON)
ONTOMORPH_API_KEY=
ONTOMORPH_BASE_URL=https://api.ontomorph.com/v1

# HOLON Knowledge API (optional — defaults to ONTOMORPH_API_KEY if empty)
HOLON_API_KEY=
HOLON_BASE_URL=https://api.holon.ai/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lifelink
# OR
DATABASE_URL=

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Encryption — Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=
